# Пример переменных окружения LogWatch.
# Скопируйте файл: cp .env.example .env и заполните значения.
# Файл .env в репозиторий НЕ коммитится.

# --- Логирование самого приложения ---
# Уровень: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOGWATCH_LOG_LEVEL=INFO
# Папка для ротируемых файлов логов
LOGWATCH_LOG_DIR=logs
# Максимальный размер одного файла лога в байтах
LOGWATCH_LOG_MAX_BYTES=1000000
# Сколько старых файлов хранить
LOGWATCH_LOG_BACKUP_COUNT=5

# --- Алерты ---
# Сколько ошибок (ERROR и выше) за окно времени вызывает алерт
LOGWATCH_ALERT_ERROR_THRESHOLD=10
# Размер окна в секундах
LOGWATCH_ALERT_WINDOW_SECONDS=60

# --- Telegram (необязательно) ---
LOGWATCH_TELEGRAM_BOT_TOKEN=
LOGWATCH_TELEGRAM_CHAT_ID=

# --- REST API ---
LOGWATCH_API_HOST=127.0.0.1
LOGWATCH_API_PORT=8000
